# Copy to .env (gitignored) and fill in. senpai HARD-REQUIRES GITHUB_TOKEN and EXA_API_KEY.
# GITHUB_TOKEN: prefer a FINE-GRAINED PAT scoped to only wandb/bioreasonpro-senpai
#               (contents + pull-request: write), short expiry. It is injected into every
#               student container running agent-edited train.py.
GITHUB_TOKEN=
EXA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# W&B (Models + Weave)
WANDB_API_KEY=
WANDB_ENTITY=wandb-healthcare
WANDB_PROJECT=bioreasonpro-senpai

# Hugging Face (optional gated datasets and approved Apache-2.0/MIT model downloads)
HF_TOKEN=
