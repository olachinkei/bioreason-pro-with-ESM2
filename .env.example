# Copy to .env (gitignored) and fill in your credentials.
# W&B (Models + Weave)
WANDB_API_KEY=
WANDB_ENTITY=your-wandb-entity
WANDB_PROJECT=your-wandb-project

# Hugging Face: set when required for dataset or model access.
HF_TOKEN=

# Optional override for all Slurm launcher container images (Pyxis/Enroot).
# The image must provide CUDA, Python, uv, and the required training dependencies.
# BIOREASON_PRO_CONTAINER_IMAGE=docker://your-registry/your-image:tag
